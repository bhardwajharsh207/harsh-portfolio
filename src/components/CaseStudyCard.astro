---
import type { CollectionEntry } from "astro:content";
import { getCaseStudyPath } from "@/lib/content";

interface Props {
  caseStudy: CollectionEntry<"caseStudies">;
  variant?: "light" | "dark";
}

const { caseStudy, variant = "light" } = Astro.props;
const data = caseStudy.data;
const isDark = variant === "dark";
const href = getCaseStudyPath(caseStudy);
---

<article
  class:list={[
    "group flex h-full flex-col border p-6 transition",
    isDark
      ? "border-white/10 bg-white/[0.04] text-white hover:border-teal-300/50"
      : "border-[var(--color-line)] bg-[var(--color-paper)] hover:border-[var(--color-accent)]",
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p
        class:list={[
          "text-xs font-semibold uppercase tracking-[0.18em]",
          isDark ? "text-white/45" : "text-[var(--color-accent)]",
        ]}
      >
        {data.company}
      </p>
      <h3 class="mt-4 text-2xl font-semibold leading-tight">{data.shortTitle ?? data.title}</h3>
    </div>
    {
      data.heroMetric && (
        <div class:list={["text-right", isDark ? "text-white/70" : "text-[var(--color-muted)]"]}>
          <p class="text-xl font-semibold">{data.heroMetric.value}</p>
          <p class="text-xs">{data.heroMetric.label}</p>
        </div>
      )
    }
  </div>
  <p class:list={["mt-4 flex-1 text-sm leading-6", isDark ? "text-white/65" : "text-[var(--color-muted)]"]}>
    {data.summary}
  </p>
  <div class="mt-5 flex flex-wrap gap-2">
    {
      data.tags.slice(0, 3).map((tag) => (
        <span
          class:list={[
            "border px-2.5 py-1 text-xs",
            isDark ? "border-white/10 text-white/55" : "border-[var(--color-line)] text-[var(--color-muted)]",
          ]}
        >
          {tag}
        </span>
      ))
    }
  </div>
  <a
    href={href}
    class:list={[
      "mt-6 inline-flex text-sm font-semibold transition",
      isDark ? "text-teal-300 group-hover:text-white" : "text-[var(--color-accent)] group-hover:text-[var(--color-accent-dark)]",
    ]}
  >
    Read case study
  </a>
</article>
