---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Contact - Harsh Bhardwaj">
  <section class="container-page py-16 sm:py-24">
    <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)]">Contact</p>
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">Let’s connect.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--color-muted)]">
      LinkedIn, GitHub, email, and resume links will live here.
    </p>
  </section>
</BaseLayout>

