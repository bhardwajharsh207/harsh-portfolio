---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profileImage } from "@/lib/site";
---

<BaseLayout
  title="About - Harsh Bhardwaj"
  description="Harsh Bhardwaj is a product manager focused on technical product work across commerce, growth, AI workflows, and scalable product systems."
>
  <section class="container-page py-16 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-center">
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)]">About</p>
        <h1 class="max-w-4xl text-4xl font-semibold tracking-tight sm:text-5xl">Product manager, builder, operator.</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-[var(--color-muted)]">
          I work on product problems where the answer is not obvious at the start: customer workflows, data-heavy
          decisions, AI-enabled tools, and systems that need to become simple enough for teams to trust and adopt.
        </p>
      </div>
      <figure class="overflow-hidden rounded-[8px] border border-[var(--color-line)] bg-[var(--color-paper-strong)]">
        <img
          src={profileImage}
          alt="Harsh Bhardwaj"
          width="400"
          height="600"
          class="aspect-[2/3] w-full object-cover"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="container-page grid gap-10 pb-20 lg:grid-cols-[0.85fr_1.15fr]">
    <div>
      <h2 class="text-3xl font-semibold tracking-tight">How I Work</h2>
      <p class="mt-4 leading-8 text-[var(--color-muted)]">
        My strongest work sits between strategy and execution. I like shaping the problem, designing the operating
        path, aligning teams, and staying close enough to the system details to make the product usable in practice.
      </p>
    </div>
    <div class="grid gap-4">
      <div class="border border-[var(--color-line)] bg-[var(--color-paper)] p-5">
        <p class="text-lg font-semibold">Start with the user workflow and the business pressure behind it.</p>
      </div>
      <div class="border border-[var(--color-line)] bg-[var(--color-paper)] p-5">
        <p class="text-lg font-semibold">Use data and customer evidence to find the problem shape before choosing the roadmap.</p>
      </div>
      <div class="border border-[var(--color-line)] bg-[var(--color-paper)] p-5">
        <p class="text-lg font-semibold">Make technical systems understandable enough for customers and teams to trust.</p>
      </div>
      <div class="border border-[var(--color-line)] bg-[var(--color-paper)] p-5">
        <p class="text-lg font-semibold">Ship in phases when the complete vision is too large to validate at once.</p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-charcoal)] py-16 text-white">
    <div class="container-page grid gap-8 md:grid-cols-3">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-300">Domain</p>
        <p class="mt-3 text-2xl font-semibold">Commerce, growth, AI, and workflow systems</p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-300">Style</p>
        <p class="mt-3 text-2xl font-semibold">Structured, customer-led, technically curious</p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-300">Proof</p>
        <p class="mt-3 text-2xl font-semibold">Case studies, build logs, and working product experiments</p>
      </div>
    </div>
  </section>
</BaseLayout>
