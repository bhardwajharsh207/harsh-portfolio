---
import { getCollection } from "astro:content";
import LabProjectCard from "@/components/LabProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortByPriority } from "@/lib/content";

const labProjects = sortByPriority(await getCollection("labProjects"));
---

<BaseLayout title="Lab - Harsh Bhardwaj">
  <section class="container-page py-16 sm:py-24">
    <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)]">Lab</p>
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">Product experiments and build tracks.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--color-muted)]">
      Two experiments are being spun out as product concepts: a lead-generation system for local businesses and a
      local-first audio digest workflow.
    </p>
  </section>
  <section class="container-page pb-20">
    <div class="grid gap-5 md:grid-cols-2">
      {labProjects.map((project) => <LabProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
